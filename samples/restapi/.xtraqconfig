{
    "Namespace": "",
    "OutputDir": "Xtraq",
    "TargetFramework": "net10",
    "Api": {
        "Mode": "Minimal",
        "Requests": {
            "Hydrate": [
                "@UserId INT",
                "@Entries shared.AuditLogEntryTableType READONLY"
            ],
            "HydrateProcedures": [
                "sample.UserCompositeJsonSnapshot",
                "sample.WriteAuditLogEntries"
            ]
        }
    },
    "BuildSchemas": [],
    "EntityFramework": {
        "Enabled": false
    },
    "ResultSet": {
        "Json": {
            "IncludeNullValues": false
        }
    }
}