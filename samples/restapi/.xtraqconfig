{
    "$schema": "../../docs/public/xtraqconfig.schema.json",
    "Namespace": "Xtraq.Samples.RestApi",
    "Api": {
        "Requests": {
            "AutoBind": [
                "@UserId INT",
                "@Entries shared.AuditLogEntryTableType READONLY"
            ],
            "AutoBindProcedures": [
                "sample.UserCompositeJsonSnapshot",
                "sample.WriteAuditLogEntries"
            ]
        }
    },
    "BuildSchemas": [
        "sample"
    ],
    "EntityFramework": {
        "Enabled": false
    },
    "ResultSet": {
        "Json": {
            "IncludeNullValues": false
        }
    }
}
